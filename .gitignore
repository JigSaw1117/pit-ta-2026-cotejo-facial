node_modules/
.netlify/
*.log

# Los .onnx pesan más de 100 MB: GitHub los rechaza sin Git LFS. Se despliegan a Netlify
# directo (netlify deploy), no por git. Ver README para cómo conseguirlos.
models/*/*.onnx

# Nunca al repositorio: fotos originales, CSV ni embeddings (quedarían ligados a las
# miniaturas públicas + el vector exacto de cada rostro, más sensible que la miniatura sola).
# Las miniaturas y los metadatos (nombre/delito, ya públicos en PNP/Interpol) sí se versionan,
# porque ahora el repo es la fuente del despliegue automático en Netlify.
gallery/source/
gallery/*.csv
gallery/embeddings*.ndjson
